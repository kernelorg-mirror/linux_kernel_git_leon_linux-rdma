# SPDX-License-Identifier: GPL-2.0-only
menuconfig RUST_KUNIT_TESTS
	bool "Rust KUnit tests"
	depends on KUNIT && RUST
	default KUNIT_ALL_TESTS
	help
	  This menu collects all options for Rust KUnit tests.
	  See Documentation/rust/testing.rst for how to protect
	  unit tests with these options.

	  Say Y here to enable Rust KUnit tests.

	  If unsure, say N.

if RUST_KUNIT_TESTS
config RUST_ALLOCATOR_KUNIT_TEST
	bool "KUnit tests for Rust allocator API" if !KUNIT_ALL_TESTS
	default KUNIT_ALL_TESTS
	help
	  This option enables KUnit tests for the Rust allocator API.
	  These are only for development and testing, not for regular
	  kernel use cases.

	  If unsure, say N.

config RUST_KVEC_KUNIT_TEST
	bool "KUnit tests for Rust KVec API" if !KUNIT_ALL_TESTS
	default KUNIT_ALL_TESTS
	help
	  This option enables KUnit tests for the Rust KVec API.
	  These are only for development and testing, not for
	  regular kernel use cases.

	  If unsure, say N.

config RUST_BITMAP_KUNIT_TEST
	bool "KUnit tests for Rust bitmap API" if !KUNIT_ALL_TESTS
	default KUNIT_ALL_TESTS
	help
	  This option enables KUnit tests for the Rust bitmap API.
	  These are only for development and testing, not for regular
	  kernel use cases.

	  If unsure, say N.

config RUST_KUNIT_SELFTEST
	bool "KUnit selftests for Rust" if !KUNIT_ALL_TESTS
	default KUNIT_ALL_TESTS
	help
	  This option enables KUnit selftests. These are only
	  for development and testing, not for regular kernel
	  use cases.

	  If unsure, say N.

config RUST_STR_KUNIT_TEST
	bool "KUnit tests for Rust strings API" if !KUNIT_ALL_TESTS
	default KUNIT_ALL_TESTS
	help
	  This option enables KUnit tests for the Rust strings API.
	  These are only for development and testing, not for regular
	  kernel use cases.

	  If unsure, say N.

config RUST_ATOMICS_KUNIT_TEST
	bool "KUnit tests for Rust atomics API" if !KUNIT_ALL_TESTS
	default KUNIT_ALL_TESTS
	help
	  This option enables KUnit tests for the Rust atomics API.
	  These are only for development and testing, not for regular
	  kernel use cases.

	  If unsure, say N.

config RUST_BITFIELD_KUNIT_TEST
	bool "KUnit tests for the Rust `bitfield!` macro" if !KUNIT_ALL_TESTS
	default KUNIT_ALL_TESTS
	help
	  This option enables KUnit tests for the Rust `bitfield!` macro.
	  These are only for development and testing, not for regular
	  kernel use cases.

	  If unsure, say N.

config RUST_SHARED_VMALLOC_KUNIT_TEST
	bool "KUnit tests for Rust shared vmalloc memory" if !KUNIT_ALL_TESTS
	depends on MMU
	default KUNIT_ALL_TESTS
	help
	  This option enables range, alignment and shared-access tests for
	  memory mapped into userspace. These are only for development and
	  testing, not for regular kernel use cases.

	  If unsure, say N.

config RUST_NET_NAMESPACE_KUNIT_TEST
	bool "KUnit tests for Rust namespace ownership" if !KUNIT_ALL_TESTS
	depends on NET
	default KUNIT_ALL_TESTS
	help
	  This option tests typed per-namespace registration, failure rollback,
	  reader drainage and stale-key rejection after registration is replaced.
	  These tests are intended for development, not regular kernel use.

	  If unsure, say N.

config RUST_UDP_TUNNEL_KUNIT_TEST
	bool "KUnit tests for Rust UDP tunnel ownership" if !KUNIT_ALL_TESTS
	depends on NET_UDP_TUNNEL=y
	default KUNIT_ALL_TESTS
	help
	  This option tests shared tunnel users, closing ports with outstanding
	  protocol references, and replacement of tunnel registrations while
	  old leases remain. These tests are intended for development.

	  If unsure, say N.

config RUST_UDP_PACKET_KUNIT_TEST
	bool "KUnit tests for Rust UDP packet ownership" if !KUNIT_ALL_TESTS
	depends on INET
	default KUNIT_ALL_TESTS
	help
	  This option tests UDP encapsulation header bounds and the payload
	  allocation's initialized bytes and aligned network-header space.
	  These tests are intended for development.

	  If unsure, say N.

config RUST_SKBUFF_KUNIT_TEST
	bool "KUnit tests for Rust socket buffers" if !KUNIT_ALL_TESTS
	depends on NET
	default KUNIT_ALL_TESTS
	help
	  This option enables copy and ownership tests for socket buffers.
	  These are only for development and testing, not for regular
	  kernel use cases.

	  If unsure, say N.

endif
config RUST_RDMA_ODP_KUNIT_TEST
	bool "KUnit tests for Rust on-demand RDMA memory" if !KUNIT_ALL_TESTS
	depends on KUNIT=y && RUST && INFINIBAND=y
	depends on INFINIBAND_ON_DEMAND_PAGING && INFINIBAND_VIRT_DMA
	default KUNIT_ALL_TESTS
	help
	  Test bounded copies and atomic accesses through guarded ODP PFNs.
	  Cover system-page indexing in large-page registrations, unaligned
	  user ranges and read-only access. The fixtures use owned pages;
	  they do not exercise faults or require a userspace memory map.
